PORT=4000
NODE_ENV=development

# MongoDB connection URL
# Local: mongodb://127.0.0.1:27017/grocery_ecommerce
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/grocery_ecommerce
MONGO_URL=mongodb://127.0.0.1:27017/grocery_ecommerce

# JWT secret for token signing (use any random string)
JWT_SECRET=your_secret_key_here_change_this

# Admin seller credentials (used for seller login)
SELLER_EMAIL=admin@gmail.com
SELLER_PASSWORD=admin123

# Cloudinary (optional - for image uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Stripe (optional - for online payments)
STRIPE_SECRET_KEY=

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Node environment
# development or production
NODE_ENV=development
